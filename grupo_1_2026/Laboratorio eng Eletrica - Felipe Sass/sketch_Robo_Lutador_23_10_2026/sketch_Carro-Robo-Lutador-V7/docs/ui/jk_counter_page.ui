   <item><widget class="QLabel" name="lblExplanation"><property name="text"><string>Todos os FFs recebem o mesmo clock. J=K=1 permite alternar; Q̅ é sempre o complemento de Q.</string></property><property name="wordWrap"><bool>true</bool></property><property name="styleSheet"><string notr="true">color: #98a7be;</string></property></widget></item>
